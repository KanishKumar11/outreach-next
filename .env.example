# MongoDB connection (Atlas or self-hosted)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=outreach

# Long random string used to sign login cookies. Generate: openssl rand -base64 32
AUTH_SECRET=

# Used only by `npm run seed` to create the first Super Admin
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=
